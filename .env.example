# --- Database ---
AI_SAFETY_FEED_DB_URL=postgresql://user:pass@host:5432/db?sslmode=require

# --- Azure OpenAI (chat: summaries, tags, relevance gate, novelty, titles) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# low | medium | high | none (omit the parameter). Summaries only need "low".
AZURE_OPENAI_REASONING_EFFORT=low

# --- OpenAI (embeddings: text-embedding-3-small) ---
OPENAI_API_KEY=

# --- Google Gemini (podcast transcription, Twitter classifier, summary backfill, images) ---
GEMINI_API_KEY=
# Optional overrides
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

# --- Images (rewrite_titles.py) ---
CLOUDINARY_URL=

# --- Twitter scraper (twscrape) ---
TW_USERNAME=
TW_PASSWORD=
